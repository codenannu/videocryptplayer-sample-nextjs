# Server-only Videocrypt credentials (never NEXT_PUBLIC_*)
# When unset, POST /api/playback returns mock credentials.

VIDEOCRYPT_ACCESS_KEY=
VIDEOCRYPT_SECRET_KEY=
VIDEOCRYPT_ACCOUNT_ID=

# Optional: override API host (default https://api.videocrypt.com)
# VIDEOCRYPT_API_BASE=https://api.videocrypt.com
